# Copy to backend/.env and adjust. backend/.env is git-ignored: never commit it.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

DEBUG=True

ALLOWED_HOSTS=*,localhost,127.0.0.1,0.0.0.0

# Database (local dev default, same as docker-compose.yml; change both for any real deploy)
POSTGRES_DB=familyguard
POSTGRES_USER=familyguard
POSTGRES_PASSWORD=familyguard_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Twilio (SOS SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EMERGENCY_PHONE_NUMBER=

# Firebase FCM
FIREBASE_CREDENTIALS_FILE=/app/firebase-credentials.json

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Invite code TTL (seconds)
INVITE_CODE_TTL=900

# Email for parent login codes (Gmail: use an app password, not the account password).
# Empty EMAIL_HOST_USER = codes are printed to the log: docker compose logs web
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
LOGIN_EMAIL_CODE=True
# Dev only: deliver every login code to one inbox
LOGIN_CODE_EMAIL_OVERRIDE=
